# Supabase test project
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private bucket for original resume files. The default is risingpath-resumes.
SUPABASE_RESUME_BUCKET=risingpath-resumes
# Optional. Falls back to the service role key when omitted.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Required only until the first admin password is saved in job_configs.
# Use a unique value with at least 12 characters, then remove it after initialization.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-bootstrap-password
# Optional direct database connection for migrations or SQL clients
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# Optional JWKS endpoint used by external auth/token tooling
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Alibaba Cloud Model Studio text AI (server-side only; never expose the API key to the browser)
AI_PROVIDER=alibaba
AI_LLM_TIMEOUT_MS=45000
# Optional. One attempt timeout for resume profile extraction, in milliseconds.
RESUME_PROFILE_LLM_TIMEOUT_MS=45000

# Alibaba Cloud Model Studio / DashScope server-side provider
DASHSCOPE_API_KEY=your-dashscope-api-key
ALIBABA_MODEL=qwen3.7-plus
# The centralized endpoint is convenient for testing. Use a workspace-specific
# endpoint in production and keep its region aligned with the API key.
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Alibaba Qwen3 ASR (server-side only; the browser sends audio to our API)
ALIBABA_ASR_MODEL=qwen3-asr-flash
ALIBABA_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_ASR_TIMEOUT_MS=30000

# Alibaba Qwen3 realtime ASR (server-side only; the browser connects to our WS proxy)
# Use the workspace-specific WebSocket endpoint from Model Studio, or provide the
# workspace ID and region below so the server can build it.
ALIBABA_ASR_REALTIME_URL=
ALIBABA_ASR_WORKSPACE_ID=your-model-studio-workspace-id
ALIBABA_ASR_REALTIME_REGION=cn-beijing
ALIBABA_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
ALIBABA_ASR_REALTIME_TIMEOUT_MS=15000
ALIBABA_ASR_REALTIME_HEARTBEAT=true

# Interview TTS provider (server-side only; keep the API key out of the browser)
# TTS is intentionally separate from the Alibaba text/ASR provider.
TTS_PROVIDER=cartesia
TTS_TIMEOUT_MS=30000
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_MODEL=sonic-3.5
# Cartesia API version. Keep this explicit because API behavior is versioned.
CARTESIA_VERSION=2026-03-01
CARTESIA_BASE_URL=https://api.cartesia.ai
# Overseas interview ASR: Ink-2 is English-only. A Cartesia stream is opened
# only after local VAD confirms candidate speech and is released at turn end.
CARTESIA_INK_ENABLED=true
CARTESIA_INK_MODEL=ink-2
# Ink uses a separate API revision from Sonic TTS.
CARTESIA_INK_VERSION=2026-08-14
# Keep this below the purchased STT concurrency limit. Pro (12) => 10.
CARTESIA_INK_MAX_ACTIVE_STREAMS=10
CARTESIA_INK_IDLE_CLOSE_MS=10000
CARTESIA_INK_TURN_START_THRESHOLD=0.55
CARTESIA_INK_TURN_EAGER_END_THRESHOLD=0.32
CARTESIA_INK_TURN_END_THRESHOLD=0.20
CARTESIA_INK_TURN_END_TIMEOUT_MS=1200
CARTESIA_TTS_IDLE_CLOSE_MS=10000
# TTS WebSocket is proxied by our server and outputs 44.1 kHz PCM chunks.
# Keep the same model/version/voice IDs as the HTTP fallback above.
# Use Cartesia Voice IDs.
CARTESIA_VOICE_ZH=your-cartesia-chinese-voice-id
CARTESIA_VOICE_EN=your-cartesia-english-voice-id
# Optional interviewer overrides. The built-in Cartesia catalog already varies
# by language, DNA style, persona, gender and round; use these only to pin a
# brand-approved voice for a particular combination.
# CARTESIA_VOICE_ZH_ANALYTICAL_FEMALE=your-cartesia-voice-id
# CARTESIA_VOICE_EN_EXECUTIVE_MALE=your-cartesia-voice-id

# Domestic interview route is reserved for the Alibaba ASR -> text -> TTS
# pipeline. Keep false until the Alibaba TTS endpoint and credentials have
# been configured; Cartesia Sonic remains an explicit temporary TTS fallback.
ALIBABA_TTS_ENABLED=false
ALIBABA_TTS_MODEL=
ALIBABA_TTS_BASE_URL=

# Test-only interview timeline. Keep false or unset outside a controlled QA run.
INTERVIEW_DEBUG_LOGGING=false
# Maximum lifetime of one proxied realtime ASR/TTS socket. Keep it long enough
# for a full interview, while the 60-second idle timeout still closes abandoned sockets.
INTERVIEW_REALTIME_CONNECTION_MAX_MS=1800000

# Authentication security
# Required in production. Leave unset for local development only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
# Required outside local-only development so auth emails use a public, reachable origin.
# Test environment example: https://test.example.com
# Local-only example: http://localhost:5000 (not reachable from a phone)
AUTH_SITE_URL=http://localhost:5000
# Set to true only when you want to simulate auth throttling locally.
# Production always uses the database-backed limiter.
AUTH_DEV_RATE_LIMITS=false

# Legacy beta entitlement controls. Keep disabled when access is managed by credits only.
BETA_ACCESS_ENFORCED=false
# Keep realtime voice disabled during beta until WebSocket usage is settled by actual connection duration.
BETA_REALTIME_VOICE_ENABLED=false
# Charge unified credits for AI calls. Users without enough credits cannot use AI features.
CREDITS_ENFORCED=true

# Configure these in Supabase Dashboard > Authentication > URL Configuration:
# - Site URL: http://localhost:5000 for local development
# - Redirect URL: http://localhost:5000/auth/callback
# Enable GitHub in Authentication > Providers > GitHub and add the GitHub OAuth
# Client ID and Client Secret there. Do not put the GitHub Client Secret in this file.
# Email Templates:
# - Confirm signup: use {{ .Token }} so new users can verify with the six-digit code;
#   do not use {{ .ConfirmationURL }} for the local test flow.
# - Magic Link: include {{ .Token }} for the six-digit email sign-in code;
#   do not use {{ .ConfirmationURL }} in this template.

# Optional: Techmap job sync
TECHMAP_API_KEY=your-techmap-api-key

# Read-only recruitment feed from the collection service (server-side only).
# Never expose this key through NEXT_PUBLIC_* or browser code.
JOBS_FEED_URL=https://hfscareer.com/collector-api/integrations/v1/jobs

# Optional browser extension store listings. The same MV3 package works in
# Chrome, Edge, Brave, Arc, and other Chromium-based browsers.
NEXT_PUBLIC_EXTENSION_CHROME_STORE_URL=
NEXT_PUBLIC_EXTENSION_EDGE_STORE_URL=
JOBS_FEED_API_KEY=your-read-only-integration-key
JOBS_FEED_PAGE_SIZE=500
# Incremental runs overlap this many minutes to tolerate delayed upstream writes.
JOBS_FEED_OVERLAP_MINUTES=10
# Link health checks run in bounded batches; 403/timeouts never close a job.
JOBS_LINK_CHECK_BATCH=300
JOBS_LINK_CHECK_CONCURRENCY=10
JOBS_LINK_CHECK_INTERVAL_HOURS=6
# A stale detail link is checked again immediately before auto-apply.
JOBS_DETAIL_LINK_CHECK_MAX_AGE_HOURS=6
# The custom server keeps the feed and link health state fresh in the background.
# Set JOBS_AUTO_WORKER=false when synchronization is managed by an external cron.
JOBS_AUTO_WORKER=true
JOBS_DASHBOARD_FEED_STALE_MINUTES=15
JOBS_DASHBOARD_OFFICIAL_STALE_MINUTES=120
JOBS_DASHBOARD_UPSTREAM_SNAPSHOT_STALE_MINUTES=120
JOBS_SYNC_INTERVAL_MINUTES=10
JOBS_INCREMENTAL_MAX_PAGES=30
# One incremental run stops at this budget and resumes from the last saved page.
JOBS_INCREMENTAL_MAX_DURATION_MS=240000
JOBS_SYNC_FAILURE_AUTO_RETRY=true
JOBS_SYNC_FAILURE_BATCH_SIZE=20
# Database writes use bounded batches; lower these during provider throttling.
JOBS_SYNC_WRITE_BATCH_SIZE=100
JOBS_SYNC_FALLBACK_WRITE_CONCURRENCY=8
JOBS_RECONCILE_MAX_PAGES=3
JOBS_RECONCILE_INTERVAL_HOURS=6
JOBS_WORKER_START_DELAY_SECONDS=15
JOBS_OFFICIAL_DETAILS_AUTO_SYNC=true
JOBS_OFFICIAL_DETAILS_INTERVAL_MINUTES=2
# Keep this false in development. Production enables it only in the server env.
JOB_BACKFILL_WRITE_ENABLED=false
JOBS_GENERIC_OFFICIAL_BACKFILL_WRITE_ENABLED=false
JOBS_GENERIC_OFFICIAL_BACKFILL_COMPANIES=
JOBS_CONNECTOR_BACKFILL_WRITE_ENABLED=false
JOB_BACKFILL_REQUEST_DELAY_MS=1200
JOBS_OFFICIAL_DETAILS_BATCH_SIZE=20
JOB_BACKFILL_CONCURRENCY=1
JOBS_OFFICIAL_DETAILS_COMPANIES_PER_CYCLE=1
# Optional temporary focus for an in-progress company.
JOBS_OFFICIAL_DETAILS_FOCUS_COMPANY=
JOBS_OFFICIAL_DETAILS_CHILD_TIMEOUT_MS=240000

# Historical field review is isolated from the main feed. It processes up to
# two companies in parallel and several bounded batches per company.
JOBS_HISTORICAL_FIELD_REVIEW_ENABLED=false
JOBS_HISTORICAL_FIELD_REVIEW_INTERVAL_MINUTES=1
JOBS_HISTORICAL_FIELD_REVIEW_BATCH_SIZE=20
JOBS_HISTORICAL_FIELD_REVIEW_COMPANIES_PER_CYCLE=2
JOBS_HISTORICAL_FIELD_REVIEW_BATCHES_PER_COMPANY=1000
JOBS_HISTORICAL_FIELD_REVIEW_PAUSE_DURING_FEED=false

# AI text provider. TTS and ASR are configured independently above.
AI_PROVIDER=alibaba
