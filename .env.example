# Supabase test project
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private bucket for original resume files. The default is risingpath-resumes.
SUPABASE_RESUME_BUCKET=risingpath-resumes
# Optional. Falls back to the service role key when omitted.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Optional direct database connection for migrations or SQL clients
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# Optional JWKS endpoint used by external auth/token tooling
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Alibaba Cloud Model Studio text AI (server-side only; never expose the API key to the browser)
AI_PROVIDER=alibaba
AI_LLM_TIMEOUT_MS=45000
# Optional. One attempt timeout for resume profile extraction, in milliseconds.
RESUME_PROFILE_LLM_TIMEOUT_MS=45000

# Alibaba Cloud Model Studio / DashScope server-side provider
DASHSCOPE_API_KEY=your-dashscope-api-key
ALIBABA_MODEL=qwen3.7-plus
# The centralized endpoint is convenient for testing. Use a workspace-specific
# endpoint in production and keep its region aligned with the API key.
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Alibaba Qwen3 ASR (server-side only; the browser sends audio to our API)
ALIBABA_ASR_MODEL=qwen3-asr-flash
ALIBABA_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_ASR_TIMEOUT_MS=30000

# Alibaba Qwen3 realtime ASR (server-side only; the browser connects to our WS proxy)
# Use the workspace-specific WebSocket endpoint from Model Studio, or provide the
# workspace ID and region below so the server can build it.
ALIBABA_ASR_REALTIME_URL=
ALIBABA_ASR_WORKSPACE_ID=your-model-studio-workspace-id
ALIBABA_ASR_REALTIME_REGION=cn-beijing
ALIBABA_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
ALIBABA_ASR_REALTIME_TIMEOUT_MS=15000
ALIBABA_ASR_REALTIME_HEARTBEAT=true

# Interview TTS provider (server-side only; keep the API key out of the browser)
# TTS is intentionally separate from the Alibaba text/ASR provider.
TTS_PROVIDER=cartesia
TTS_TIMEOUT_MS=30000
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_MODEL=sonic-3.5
# Cartesia API version. Keep this explicit because API behavior is versioned.
CARTESIA_VERSION=2026-03-01
CARTESIA_BASE_URL=https://api.cartesia.ai
# TTS WebSocket is proxied by our server and outputs 44.1 kHz PCM chunks.
# Keep the same model/version/voice IDs as the HTTP fallback above.
# Use Cartesia Voice IDs. A legacy Coze voice ID falls back to the configured default.
CARTESIA_VOICE_ZH=your-cartesia-chinese-voice-id
CARTESIA_VOICE_EN=your-cartesia-english-voice-id

# Authentication security
# Required in production. Leave unset for local development only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
# Required outside local-only development so auth emails use a public, reachable origin.
# Test environment example: https://test.example.com
# Local-only example: http://localhost:5000 (not reachable from a phone)
AUTH_SITE_URL=http://localhost:5000
# Set to true only when you want to simulate auth throttling locally.
# Production always uses the database-backed limiter.
AUTH_DEV_RATE_LIMITS=false

# Configure these in Supabase Dashboard > Authentication > URL Configuration:
# - Site URL: http://localhost:5000 for local development
# - Redirect URL: http://localhost:5000/auth/callback
# Enable Google in Authentication > Providers > Google and add the Google OAuth
# Client ID and Client Secret there. Do not put the Google Client Secret in this file.
# Email Templates:
# - Confirm signup: use {{ .Token }} so new users can verify with the six-digit code;
#   do not use {{ .ConfirmationURL }} for the local test flow.
# - Magic Link: include {{ .Token }} for the six-digit email sign-in code;
#   do not use {{ .ConfirmationURL }} in this template.

# Optional: Techmap job sync
TECHMAP_API_KEY=your-techmap-api-key

# Voice provider abstraction
# Supported providers: coze (default). Add new providers in src/lib/voice-provider.
VOICE_PROVIDER=coze

# AI provider abstraction
# Supported providers: coze (default). Add new providers in src/lib/ai-provider.
AI_PROVIDER=coze
