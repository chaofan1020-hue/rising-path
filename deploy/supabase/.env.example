# Liorvix 自托管 Supabase —— /opt/supabase/.env
#
# 复制成 `.env` 后填值：`cp .env.example .env && chmod 600 .env`
# 下面标 [auto] 的由 `node scripts/migrate/generate-selfhost-secrets.mjs` 生成，
# 标 [user] 的需要手填（Brevo 凭据、GitHub OAuth、域名）。
# 注意：任何值都不要写进仓库；`.env` 只存在于服务器 /opt/supabase/。

# ---------- 基础 ----------
# [auto] 随机 32 位；同时作为 GOTRUE_JWT_SECRET / PGRST_JWT_SECRET / AUTH_JWT_SECRET
JWT_SECRET=
# [auto] postgres 超管口令（同时给 supabase_auth_admin / supabase_storage_admin / authenticator）
POSTGRES_PASSWORD=
# [auto] 由 JWT_SECRET 派生的 anon / service_role JWT（HS256）
ANON_KEY=
SERVICE_ROLE_KEY=
# [auto] imgproxy 签名密钥（hex）
IMGPROXY_KEY=
IMGPROXY_SALT=

# ---------- 对外地址 ----------
# [user] 浏览器 / 应用看到的 Supabase 地址（必须与 nginx server_name 一致）
API_EXTERNAL_URL=https://supabase.liorvix.com
# [user] 前端站点（与应用 AUTH_SITE_URL 一致）
SITE_URL=https://liorvix.com
# [user] 允许的回跳地址 / CORS 来源（逗号分隔，支持 glob）
# 必须同时写**裸 origin**（`https://liorvix.com`）和带路径的 glob：
# 浏览器的 Origin 头没有路径，GoTrue 拿它跟列表里的 pattern 做 glob 匹配，
# 只写 `https://liorvix.com/**` 会导致预检请求回 204 但**没有 Access-Control-Allow-Origin**，
# 前端登录直接失败（VPS 实测，smoke-test 第 7 项 FAIL）。
URI_ALLOW_LIST=https://liorvix.com,https://liorvix.com/**,https://www.liorvix.com,https://www.liorvix.com/**,http://localhost:3000/**,http://127.0.0.1:3000/**
# 邮件链接路径：必须落在 nginx 已路由的 /auth/v1 前缀下（GoTrue 默认是 /verify，会 404）
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ---------- 邮件（Brevo SMTP relay）----------
# [user] 注意 Login 形如 xxxxx@smtp-brevo.com，不是邮箱发件地址
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@liorvix.com
SMTP_SENDER_NAME=Liorvix
# 每小时发信上限（Cloud 默认偏小，注册高峰期会 429；先放到 100 观察）
RATE_LIMIT_EMAIL_SENT=100

# ---------- 邮件模板（中文 + Liorvix 品牌）----------
# ⚠️ GoTrue v2.197 要的是 **URL**（不是本地路径）：传本地路径会被拼到 SiteURL 后面
#    变成 https://liorvix.com/etc/... → 发信 500（VPS 实测）。正文文件在 ./templates，
#    由 nginx 的 `location /auth-templates/` 只读暴露（见 deploy/nginx/supabase.conf）。
# 不配的话会发 GoTrue 自带英文模板（"Confirm your signup"），用户会以为收到了钓鱼邮件。
MAILER_TPL_CONFIRMATION=https://supabase.liorvix.com/auth-templates/confirmation.html
MAILER_TPL_RECOVERY=https://supabase.liorvix.com/auth-templates/recovery.html
MAILER_TPL_MAGIC_LINK=https://supabase.liorvix.com/auth-templates/magic_link.html
MAILER_TPL_EMAIL_CHANGE=https://supabase.liorvix.com/auth-templates/email_change.html
MAILER_TPL_INVITE=https://supabase.liorvix.com/auth-templates/invite.html
MAILER_SUBJECT_CONFIRMATION=验证你的 Liorvix 邮箱
MAILER_SUBJECT_RECOVERY=重置你的 Liorvix 密码
MAILER_SUBJECT_MAGIC_LINK=你的 Liorvix 登录验证码
MAILER_SUBJECT_EMAIL_CHANGE=确认 Liorvix 邮箱变更
MAILER_SUBJECT_INVITE=邀请你加入 Liorvix
# 对外域名白名单：不配会刷 "X-Forwarded-Host ... will not be used" 警告
MAILER_EXTERNAL_HOSTS=supabase.liorvix.com,liorvix.com

# ---------- GitHub OAuth（新的 self-host App）----------
# 先在 GitHub 建一个新 OAuth App：Authorization callback URL =
#   https://supabase.liorvix.com/auth/v1/callback
# 填好 ID/SECRET 之后再把 GITHUB_ENABLED 改成 true（留空时为 false，避免 Auth 报错）
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- 服务行为 ----------
DISABLE_SIGNUP=false
JWT_EXP=3600
GOTRUE_DB_MAX_POOL_SIZE=10
GOTRUE_LOG_LEVEL=info
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_POOL=20
PGRST_LOG_LEVEL=error
STORAGE_TENANT_ID=liorvix
STORAGE_REGION=us-west-1
STORAGE_S3_BUCKET=liorvix-storage
STORAGE_LOG_LEVEL=info
FILE_SIZE_LIMIT=52428800

# ---------- 镜像版本（官方 compose 的 pin，升级前先在演练库验证）----------
POSTGRES_VERSION=17.6.1.136
GOTRUE_VERSION=v2.197.0
POSTGREST_VERSION=v14.18
STORAGE_VERSION=v1.89.12
IMGPROXY_VERSION=v4.0.21
META_VERSION=v0.100.0
STUDIO_VERSION=2026.11.02-sha-a05e7ec

# 若演练时 GoTrue 报 `auth.schema_migrations` 落后（Cloud 为 20261030120000），
# 单独把它升到 v2.198.0 再验证（计划 §6.2 的唯一"必要时升级"点）：
# GOTRUE_VERSION=v2.198.0