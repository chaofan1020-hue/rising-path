# Liorvix 巡检/告警配置。安装位置：/etc/liorvix/monitor.env
# 由 systemd 通过 EnvironmentFile=-/etc/liorvix/monitor.env 读取（文件不存在也能启动）。
# 这里的变量会覆盖 /opt/supabase/.env 里的同名 SMTP 配置。

# ── 收件人 ───────────────────────────────────────────────────────────────
# 告警发到哪个邮箱，逗号分隔。留空 = 回退到 /opt/supabase/.env 的 SMTP_ADMIN_EMAIL。
# 改成你自己的常用邮箱／值班邮箱即可，改完不用重启（每次发信都会重新读这个文件）。
# ALERT_EMAIL_TO=you@liorvix.com

# ── 发信通道（默认复用自托管 GoTrue 的 Brevo SMTP，一般不用改） ─────────
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=noreply@liorvix.com
# SMTP_SENDER_NAME=Liorvix

# ── 邮件外观 ─────────────────────────────────────────────────────────────
# ALERT_SUBJECT_PREFIX=[Liorvix]

# ── 告警节奏 ─────────────────────────────────────────────────────────────
# 持续异常时的提醒间隔（秒），默认 3600 = 每小时一次
# ALERT_REMINDER_SEC=3600

# ── 阈值（一般不用动，改完下次巡检生效） ─────────────────────────────────
# 同步进程多久没有新运行就算死（分钟）
# WORKER_MAX_MIN=45
# WORKER_WARN_MIN=20
# 岗位数据多久没有更新算停更（分钟）
# WRITE_MAX_MIN=180
# WRITE_WARN_MIN=90
# TLS 证书剩余天数阈值
# TLS_FAIL_DAYS=14
# TLS_WARN_DAYS=30

# ── 恢复演练 ─────────────────────────────────────────────────────────────
# NO_MAIL=1                 # 只出报告不发信
# KEEP_DRILL_DB=1           # 演练失败时保留临时库供排查（默认删除）