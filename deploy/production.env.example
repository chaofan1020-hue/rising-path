# Copy this file to /opt/liorvix/.env.local and replace every placeholder.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=5000
AUTH_SITE_URL=https://YOUR_DOMAIN
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PRODUCTION_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRODUCTION_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://YOUR_PRODUCTION_DATABASE_CONNECTION_STRING
SUPABASE_RESUME_BUCKET=resumes
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
AI_PROVIDER=alibaba
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
CARTESIA_API_KEY=YOUR_CARTESIA_API_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# The systemd timers in deploy/systemd own feed and lifecycle scheduling.
JOBS_AUTO_WORKER=true
JOBS_DASHBOARD_FEED_STALE_MINUTES=15
JOBS_DASHBOARD_OFFICIAL_STALE_MINUTES=120
JOBS_DASHBOARD_UPSTREAM_SNAPSHOT_STALE_MINUTES=120
JOBS_SYNC_FAILURE_AUTO_RETRY=true
JOBS_SYNC_FAILURE_BATCH_SIZE=20
JOBS_SYNC_WRITE_BATCH_SIZE=100
JOBS_SYNC_FALLBACK_WRITE_CONCURRENCY=8
JOBS_INCREMENTAL_MAX_PAGES=30
JOBS_INCREMENTAL_MAX_DURATION_MS=240000
JOBS_OFFICIAL_DETAILS_AUTO_SYNC=true
JOBS_OFFICIAL_DETAILS_INTERVAL_MINUTES=0.1
JOB_BACKFILL_WRITE_ENABLED=true
# Generic official detail writes stay disabled until a company's 20-job canary passes.
JOBS_GENERIC_OFFICIAL_BACKFILL_WRITE_ENABLED=false
JOBS_GENERIC_OFFICIAL_BACKFILL_COMPANIES=
JOBS_CONNECTOR_BACKFILL_WRITE_ENABLED=true
JOB_BACKFILL_REQUEST_DELAY_MS=1200
JOBS_OFFICIAL_DETAILS_BATCH_SIZE=100
JOB_BACKFILL_CONCURRENCY=3
JOBS_OFFICIAL_DETAILS_COMPANIES_PER_CYCLE=3
# Independent, low-priority historical field review. It never shares the
# live feed cursor/lease and can be paused by setting this to false.
JOBS_HISTORICAL_FIELD_REVIEW_ENABLED=false
JOBS_HISTORICAL_FIELD_REVIEW_INTERVAL_MINUTES=1
JOBS_HISTORICAL_FIELD_REVIEW_BATCH_SIZE=20
JOBS_HISTORICAL_FIELD_REVIEW_COMPANIES_PER_CYCLE=2
JOBS_HISTORICAL_FIELD_REVIEW_BATCHES_PER_COMPANY=1000
JOBS_HISTORICAL_FIELD_REVIEW_PAUSE_DURING_FEED=false
JOBS_OFFICIAL_DETAILS_FOCUS_COMPANY=
JOBS_OFFICIAL_DETAILS_CHILD_TIMEOUT_MS=240000
JOBS_FEED_API_KEY=YOUR_READ_ONLY_JOBS_FEED_KEY
BETA_ACCESS_ENFORCED=true
CREDITS_ENFORCED=true
INTERVIEW_DEBUG_LOGGING=false
